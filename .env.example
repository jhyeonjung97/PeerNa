# Copy this to ~/.config/ai-peer-reviewer/.env — NOT here. This directory may be
# synced to the cloud, which would upload your keys. .gitignore does not stop that.
#
# AI Peer Reviewer — credentials and defaults
#
# Paste each key after the = on its line. No quotes, no spaces around the =.
# You only need the key for the provider whose model you are using.
#
# This file is deliberately outside the project directory, which lives in Google
# Drive. Anything in there is uploaded and travels with anyone the folder is
# shared with. Keep the keys here instead.
#
# If a key ever leaks, revoke it and paste a new one here — revoking is instant.

# OpenAI — needed for: luna
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic — needed for: fable, opus, sonnet, haiku
# Get one at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Which model to use when --model is not passed.
#
#   luna     GPT-5.6 Luna   OpenAI      ~$0.03/paper   cheapest, shallowest
#   haiku    Haiku 4.5      Anthropic   ~$0.15/paper
#   sonnet   Sonnet 5       Anthropic   ~$0.60/paper
#   opus     Opus 5         Anthropic   ~$0.75/paper   best value for real reviews
#   fable    Fable 5        Anthropic   ~$2.00/paper   most capable
#
# Changing this line is the whole switch — set the matching key above first.
# Or override per run: --model opus
AI_PEER_REVIEWER_MODEL=opus
